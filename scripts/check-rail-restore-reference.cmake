cmake_minimum_required(VERSION 3.20)
foreach(required ORACLE RUN_DIR CONFIG INPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
get_filename_component(RUN_DIR "${RUN_DIR}" ABSOLUTE)
if(EXISTS "${RUN_DIR}")
    message(FATAL_ERROR "Rail restoration run must be fresh")
endif()
file(MAKE_DIRECTORY "${RUN_DIR}")
file(SHA256 "${ORACLE}" oracle_hash)
file(SHA256 "${INPUT}" input_hash)
file(SHA256 "${CONFIG}" config_hash)
unset(ENV{OTTD_RAIL_RESTORE_PREPARE})
unset(ENV{OTTD_RAIL_RESTORE_PATH})
unset(ENV{OTTD_RAIL_RESTORE_ENGINE})
if(DEFINED ENGINE)
    if(NOT ENGINE MATCHES "^(0|8|13)$")
        message(FATAL_ERROR "Rail fixture requires a selected original temperate singlehead")
    endif()
    set(phase native-build-move-stop-save)
    set(TICKS 1000)
    set(ENV{OTTD_RAIL_RESTORE_PREPARE} "${RUN_DIR}/fixture.txt")
    set(ENV{OTTD_RAIL_RESTORE_ENGINE} "${ENGINE}")
elseif(PASSIVE_CONTROL)
    set(phase observer-disabled-control)
    set(TICKS 1)
else()
    set(phase after-load-before-tick)
    set(TICKS 1)
    set(ENV{OTTD_RAIL_RESTORE_PATH} "${RUN_DIR}/rail.json")
endif()
file(WRITE "${RUN_DIR}/invocation.txt"
    "ORACLE=${ORACLE}\nORACLE_SHA256=${oracle_hash}\nINPUT=${INPUT}\nINPUT_SHA256=${input_hash}\nCONFIG=${CONFIG}\nCONFIG_SHA256=${config_hash}\nENGINE=${ENGINE}\nTICKS=${TICKS}\nPHASE=${phase}\nUPSTREAM=14ec60f248547d4d062a1160f0fc26d742319888\n")
include("${CMAKE_CURRENT_LIST_DIR}/run-reference.cmake")
if(DEFINED ENGINE)
    if(NOT EXISTS "${RUN_DIR}/fixture.txt.stopped")
        message(FATAL_ERROR "Original engine did not move and stop on plain track")
    endif()
elseif(PASSIVE_CONTROL)
    if(EXISTS "${RUN_DIR}/rail.json")
        message(FATAL_ERROR "Disabled rail observer produced an observation")
    endif()
else()
    file(READ "${RUN_DIR}/rail.json" observation)
    string(JSON count LENGTH "${observation}" rail)
    string(JSON speed GET "${observation}" rail 0 current_speed)
    if(NOT count EQUAL 1 OR NOT speed EQUAL 0)
        message(FATAL_ERROR "Expected one stopped original locomotive")
    endif()
endif()
file(WRITE "${RUN_DIR}/result.txt" "PASS ${phase}; native exit 0\n")
message(STATUS "PASS rail restoration ${phase}")
